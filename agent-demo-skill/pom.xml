<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentdemo</groupId>
        <artifactId>agent-demo</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agent-demo-skill</artifactId>
    <name>agent-demo-skill</name>
    <description>Skill 能力域 - 技能定义/存储/校验/会话激活态/提示词组装/loadSkill 工具</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-tools</artifactId>
        </dependency>
        <!-- agent-context-engineering Task-05：SkillLoadTool 激活时写技能指令附件进会话记忆（skill→memory，memory 不依赖 skill 无环） -->
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-memory</artifactId>
        </dependency>
        <!-- CR-001：Skill 激活埋点（SkillSessionManager 上报 TraceCollector） -->
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-observability</artifactId>
        </dependency>

        <!-- LangChain4j 核心（@Tool 注解） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- ByteBuddy（脚本工具动态生成，知识库动态工具先例，CR-001 Task-33） -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>

        <!-- Spring Boot（SkillProperties 需要 @ConfigurationProperties） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
