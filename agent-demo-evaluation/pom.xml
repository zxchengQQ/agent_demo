<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentdemo</groupId>
        <artifactId>agent-demo</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agent-demo-evaluation</artifactId>
    <name>agent-demo-evaluation</name>
    <description>评估能力域 - 本地评估 harness（数据集执行 / LLM-as-judge / 回归基线 / A/B 对比，CR-002）</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-observability</artifactId>
        </dependency>
        <!-- 真实对话发起（SimpleAgent）+ judge 模型解析（ModelFactory） -->
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-tools</artifactId>
        </dependency>

        <!-- LangChain4j 核心（ChatModel 类型，judge 调用） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- Spring Boot（EvalProperties @ConfigurationProperties / 配置类） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包插件（评估 CLI 独立入口：mvn -pl agent-demo-evaluation spring-boot:run） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.agentdemo.evaluation.cli.EvaluationCli</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
