<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentdemo</groupId>
        <artifactId>agent-demo</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agent-demo-mcp</artifactId>
    <name>agent-demo-mcp</name>
    <description>MCP 协议模块 - 客户端角色，集成 stdio/SSE 双传输方式，连接外部 MCP Server 并将其工具注册到 ToolRegistry</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-tools</artifactId>
        </dependency>
        <!-- CR-001：MCP 协议层埋点（McpToolExecutor 上报 TraceCollector） -->
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-observability</artifactId>
        </dependency>

        <!-- LangChain4j 核心 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- LangChain4j MCP 集成（beta 版，独立版本线） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mcp</artifactId>
        </dependency>

        <!-- ByteBuddy - 运行时动态生成带 @Tool 注解的 MCP 工具代理类（参考 CR-003 KnowledgeBaseToolFactory） -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>

        <!-- Spring Boot（McpProperties 需要 @ConfigurationProperties） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Bean Validation（DTO 参数校验） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
