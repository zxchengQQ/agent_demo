<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentdemo</groupId>
        <artifactId>agent-demo</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>agent-demo-rag</artifactId>
    <name>agent-demo-rag</name>
    <description>RAG 模块 - 文档加载、分块、向量化、检索（知识库问答）</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-splitter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentdemo</groupId>
            <artifactId>agent-demo-tools</artifactId>
        </dependency>

        <!-- LangChain4j 核心 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- 向量存储 - Milvus 集成（可切换，配置 store-type=milvus 时生效） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-milvus</artifactId>
        </dependency>

        <!-- Milvus SDK -->
        <dependency>
            <groupId>io.milvus</groupId>
            <artifactId>milvus-sdk-java</artifactId>
        </dependency>

        <!-- Spring Boot（RagProperties 需要 @ConfigurationProperties） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Web（提供 MultipartFile 接口，DocumentService.upload 使用） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Bean Validation（DTO 参数校验） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ByteBuddy - 运行时动态生成带 @Tool 注解的知识库工具类（CR-003） -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
